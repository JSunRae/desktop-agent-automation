# Public-safe example configuration.
# Real secrets and machine-specific overrides belong in private/.env on private-main.

AUTOMATION_PRIVATE_ROOT=private
PANEL_STATE_PATH=private/runtime/panel_state.json
VSCODE_SESSION_STATE_PATH=private/runtime/vscode_desktop_sessions.json
MASTER_AGENT_PROMPT_DIR=private/generated_prompts
FINISHED_PANEL_PROMPT_PATH=private/generated_prompts/latest.txt
ALLOW_METRICS_LOG_PATH=private/runtime/allow_metrics.jsonl
ALLOW_EVENTS_PERSIST_PATH=private/runtime/allow_events.json
CROSS_REPO_TODO_CACHE_PATH=private/runtime/cross_repo_todo_cache.json
NOTIFIER_STATE_PATH=private/runtime/state.json

# Required secrets: set these only in private/.env
OPENAI_API_KEY=replace-in-private-env
TBS_URL=https://example.internal
TBS_REPO_SHARED_SECRET=replace-in-private-env
