{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "terminal.integrated.defaultProfile.linux": "bash",
  "chat.agent.maxRequests": 800,
  "chat.tools.terminal.enableAutoApprove": true,
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.metrics/**": true,
    "**/logs/**": true,
    "**/reports/**": true,
    "**/runs/**": true,
    "**/data/processed/**": true,
    "**/data/quality_gates/**": true,
    "**/data/story_questions/**": true,
    "**/data/tension_analysis/**": true,
    "**/data/quote_vectors/**": true,
    "**/data/review_queue/**": true,
    "**/data/orchestration/**": true,
    "**/data/fact_packs/**": true,
    "**/manuscript/exports/**": true,
    "**/manuscript/generated_chapters/**": true,
    "**/proposals/**": true,
    "**/proposals_generated/**": true,
    "**/proposals_normalized/**": true,
    "**/proposals_archive/**": true,
    "**/*.log": true
  },
  "search.exclude": {
    "**/.git/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.cache/**": true,
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.metrics/**": true,
    "**/logs/**": true,
    "**/reports/**": true,
    "**/runs/**": true,
    "**/data/processed/**": true,
    "**/data/quality_gates/**": true,
    "**/data/story_questions/**": true,
    "**/data/tension_analysis/**": true,
    "**/data/quote_vectors/**": true,
    "**/data/review_queue/**": true,
    "**/data/orchestration/**": true,
    "**/data/fact_packs/**": true,
    "**/manuscript/exports/**": true,
    "**/manuscript/generated_chapters/**": true,
    "**/proposals/**": true,
    "**/proposals_generated/**": true,
    "**/proposals_normalized/**": true,
    "**/proposals_archive/**": true,
    "**/*.log": true
  }
}
