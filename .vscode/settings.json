{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "terminal.integrated.defaultProfile.linux": "bash",
  "chat.agent.maxRequests": 800,
  "chat.tools.terminal.enableAutoApprove": true,
  "files.watcherExclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/venv": true,
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/logs": true,
    "**/desktop_agent_automation.egg-info": true,
    "**/.coverage": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/venv": true,
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/logs": true,
    "**/desktop_agent_automation.egg-info": true,
    "**/.coverage": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true
  }
}
