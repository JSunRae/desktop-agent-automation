{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique task identifier"
          },
          "title": {
            "type": "string",
            "description": "Task title"
          },
          "description": {
            "type": "string",
            "description": "Task description"
          },
          "status": {
            "type": "string",
            "enum": ["planned", "in_progress", "blocked", "review", "completed", "cancelled"],
            "description": "Current task status"
          },
          "priority": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"],
            "description": "Task priority level"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "Task creation timestamp in ISO format"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "Last update timestamp in ISO format"
          },
          "assignee": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["human", "agent", "bot"],
                "description": "Assignee type"
              },
              "id": {
                "type": "string",
                "description": "Assignee identifier"
              },
              "mode": {
                "type": "string",
                "enum": ["active", "passive"],
                "description": "Assignment mode"
              }
            },
            "required": ["type", "id"]
          },
          "claimed_by": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["human", "agent", "bot"],
                "description": "Claimant type"
              },
              "id": {
                "type": "string",
                "description": "Claimant identifier"
              },
              "mode": {
                "type": "string",
                "enum": ["active", "passive"],
                "description": "Claim mode"
              }
            },
            "required": ["type", "id"]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "author": {
                  "type": "string",
                  "description": "Note author"
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Note timestamp"
                },
                "message": {
                  "type": "string",
                  "description": "Note message"
                },
                "kind": {
                  "type": "string",
                  "enum": ["info", "warning", "error", "success"],
                  "description": "Note kind"
                },
                "artifact_paths": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Paths to related artifacts"
                }
              },
              "required": ["author", "timestamp", "message"]
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Task dependencies (task IDs)"
          },
          "estimate_hours": {
            "type": "number",
            "description": "Estimated hours to complete"
          },
          "due_date": {
            "type": "string",
            "format": "date",
            "description": "Due date in YYYY-MM-DD format"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Task tags"
          }
        },
        "required": ["id", "title", "description", "status", "priority", "created_at", "updated_at"]
      }
    }
  },
  "required": ["tasks"]
}